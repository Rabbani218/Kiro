node_modules/
bower_components/

# ── Build output ───────────────────────────────────────────────
dist/
build/
out/

# ── Environment & secrets ──────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json

# ── Logs & temp files ──────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.temp
*.cache

# ── Package manager lock files (optional for static sites) ────
package-lock.json
yarn.lock
pnpm-lock.yaml

# ── Vercel local dev cache ─────────────────────────────────────
.vercel
